# Template only. `npm run env:mainnet -- --apply` copies it to .env.mainnet (ignored, chmod 600).
# Mainnet scripts read ONLY .env.mainnet. Values left in the shell are ignored.

# Fixed by the scripts. Do not edit.
NETWORK=bscMainnet
CHAIN_ID=56
BSC_MAINNET_USDT=0x55d398326f99059fF775485246999027B3197955
CONFIRMATIONS=15

# Fill by hand after env:mainnet --apply.
BSC_MAINNET_RPC=
# Indexer only. Tokenized archive RPC. Empty uses BSC_MAINNET_RPC. Do not commit the token.
BSC_MAINNET_INDEX_RPC=
BSC_MAINNET_PUBLIC_RPC=https://bsc-dataseed.binance.org
MAINNET_OWNER=
MAINNET_PUBLISHER=
# Reown / WalletConnect project id for imToken QR signing. Not a private key.
# Create one at https://cloud.reown.com before the first phone signature.
WALLETCONNECT_PROJECT_ID=
# Temporary until the image is published on www.freedao.life. Change this and call setImageURI after launch.
NFT_IMAGE_URI=https://test.freedao.life/media/nomad/rwa-nft-pass.webp
MAX_ROOT_INCREASE_WEI=
HISTORICAL_TEAM_BUDGET_WEI=0
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PREVIEW_DATABASE_URL=
# Separate empty database used once by db-backup:mainnet -- --restore-check.
RESTORE_DATABASE_URL=
BSCSCAN_API_KEY=

# One-time deployer. Generated by env:mainnet --apply, cleared by handover:mainnet -- --retire-deployer.
MAINNET_PRIVATE_KEY=
MAINNET_DEPLOYER=

# Written by deploy:mainnet -- --apply.
BSC_MAINNET_CKEY=
BSC_MAINNET_NFT=
BSC_MAINNET_IDO=
BSC_MAINNET_REWARDS=
BSC_MAINNET_INTEREST=
INDEX_START_BLOCK=
START_BLOCK=
RPC_URL=
IDO_ADDRESS=
REWARDS_ADDRESS=

# Indexer and root publishing.
CHUNK_BLOCKS=2000
# Empty/0: old five tiers. Positive height: switch to V2 at that block; decide explicitly.
TEAM_TIER_SWITCH_BLOCK=
# https directory ending with /. --content-uri writes this link only when the root already matches.
CONTENT_URI=
